{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "4e13a27c-a233-4f4a-963b-3cdf06b9a6aa"
  },
  "newProjectRoot": "projects",
  "projects": {
    "fcof": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "testes.html",
                "input": "."
              },
              {
                "glob": "data/**/*",
                "input": "."
              },
              {
                "glob": "vendor/**/*",
                "input": "."
              }
            ],
            "styles": [
              "style.css"
            ],
            "scripts": [
              "vendor/pdf-lib.min.js",
              "data/ficha-oficial-template.js",
              "data/tabelas.js",
              "data/pericias.js",
              "data/ocupacoes.js",
              "data/armas.js",
              "regras.js",
              "pdf-export.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "8MB",
                  "maximumError": "12MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "fcof:build:production"
            },
            "development": {
              "buildTarget": "fcof:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
